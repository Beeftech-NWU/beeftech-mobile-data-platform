<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Android 11+: lets the app see a camera app to hand the photo capture to. -->
    <queries>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
    </queries>

    <!--
        Development-only: the local Ktor backend is served over HTTP at
        10.0.2.2:8081 from the Android emulator.
        Replace this with HTTPS / a scoped network-security configuration
        before production release.
    -->
    <application
        android:usesCleartextTraffic="true">

        <!-- Hands the camera app a write-only target for one photo; the app needs no CAMERA permission. -->
        <provider
            android:name="com.beeftech.calfregistration.util.CalfFileProvider"
            android:authorities="${applicationId}.calfregistration.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/calf_file_paths" />
        </provider>

    </application>

</manifest>
